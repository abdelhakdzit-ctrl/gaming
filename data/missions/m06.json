 "lines": {
  "fatsockfuel_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Mule Two went down in the valley. Two engineers alive, beacon active. Heron-One is on standby, but she needs a clean corridor.",
    "fr": "Mule Deux est tombé dans la vallée. Deux ingénieurs vivants, balise active. Heron-Un est prêt mais il lui faut un couloir dégagé.",
    "ar": "ميول اثنان سقطت في الوادي. مهندسان حيّان والمنارة تعمل. هيرون واحد جاهزة لكنها تحتاج ممرًا نظيفًا."
   }
  },
  "fatsockfuel_2": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Copy. SAM on the pass first. Heron launches when it is dead.",
    "fr": "Reçu. Le SAM du col d'abord. Heron décolle quand il est détruit.",
    "ar": "مفهوم. صاروخ الممر أولًا. هيرون تقلع عندما يسقط."
   }
  },
  "fatsockfuel_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Pass is clear. Heron-One is launching. Second battery is waking up in the valley — take it out before she arrives.",
    "fr": "Le col est dégagé. Heron-Un décolle. Une seconde batterie se réveille dans la vallée — détruisez-la avant son arrivée.",
    "ar": "الممر نظيف. هيرون واحد تقلع. بطارية ثانية تستيقظ في الوادي — دمّرها قبل وصولها."
   }
  },
  "fatsockfuel_4": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Karim, Sana — hold on. We're coming.",
    "fr": "Karim, Sana — tenez bon. On arrive.",
    "ar": "كريم، سناء — اصمدا. نحن قادمون."
   }
  },
  "fatsockfuel_5": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Heron is on station, hovering for the pickup. Bandits inbound to the valley — keep the sky clear!",
    "fr": "Heron est en station, stationnaire pour la récupération. Bandits en approche — dégagez le ciel !",
    "ar": "هيرون في موقعها تحوم للالتقاط. أعداء قادمون إلى الوادي — أبقوا السماء نظيفة!"
   }
  },
  "fatsockfuel_6": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Heron has them. Two on board, heading home. Stay on her wing, Falcon.",
    "fr": "Heron les a. Deux à bord, retour à la base. Restez sur son aile, Falcon.",
    "ar": "هيرون التقطتهما. اثنان على متنها، عائدة. ابقَ إلى جانبها يا فالكون."
   }
  },
  "fatsockfuel_7": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "They're alive. Karim says the strike team wore VESPER patches — but flew with Command-issue transponders.",
    "fr": "Ils sont vivants. Karim dit que l'équipe portait des écussons VESPER — mais volait avec des transpondeurs du Commandement.",
    "ar": "إنهما حيّان. يقول كريم إن فريق الضربة كان يضع شارات فيسبر — لكن بأجهزة تعريف من القيادة."
   }
  },
  "fatsockfuel_8": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Command-issue. Riad, you heard that?",
    "fr": "Équipement du Commandement. Riad, tu a entendu ?",
    "ar": "أجهزة القيادة. رياض، هل سمعت ذلك؟"
   }
  }
 },
