 "lines": {
  "blindskyeyes_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "The whole coastal radar grid is dead. I'll call bandits by bearing. Visual identification only.",
    "fr": "Toute la grille radar côtière est morte. J'annonce les bandits au cap. Identification visuelle uniquement.",
    "ar": "شبكة الرادار الساحلية كلها ميتة. سأنادي الأعداء بالاتجاه. التعريف بصريًا فقط."
   }
  },
  "blindskyeyes_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Same blackout signature as Echo-Four. Someone wants us blind at dawn.",
    "fr": "Même signature de brouillage d'Echo-Quatre. Quelqu'un veut nous aveugler à l'aube.",
    "ar": "نفس بصمة التعتيم في إيكو-فور. أحدهم يريدنا عميانًا عند الفجر."
   }
  },
  "blindskyeyes_3": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "No scope, no lock — close within six kilometres, nose on target, and the heat seeker will find them.",
    "fr": "Pas d'écran, pas de verrou — approchez à six kilomètres, nez sur la cible, et l'infrarouge les trouvera.",
    "ar": "لا شاشة ولا قفل — اقترب لست كيلومترات، الأنف على الهدف، وسيجدهم الباحث الحراري."
   }
  },
  "blindskyeyes_4": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "More bandits from the north-west! They are hunting the power plant.",
    "fr": "D'autres bandits par le nord-ouest ! Ils chassent la centrale.",
    "ar": "أعداء آخرون من الشمال الغربي! يطاردون محطة الكهرباء."
   }
  },
  "blindskyeyes_5": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "The radar is coming back — all of it. Good work, Falcon.",
    "fr": "Le radar revient — complètement. Beau travail, Falcon.",
    "ar": "الرادار يعود — بالكامل. عمل ممتاز يا فالكون."
   }
  },
  "blindskyeyes_6": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "They blinded us to move at dawn. This was only the opening move.",
    "fr": "Ils nous ont aveuglés pour agir à l'aube. Ce n'était que le premier coup.",
    "ar": "أعموننا ليتحركوا عند الفجر. كانت مجرد خطوة افتتاحية."
   }
  }
 },
