 "lines": {
  "falsebannerflag_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Central Picture update: tracks U-4 and U-5, hostile, weapons free. U-2 and U-3 are friendly escorts.",
    "fr": "Mise à jour de l'image centrale : pistes U-4 et U-5 hostiles, tir autorisé. U-2 et U-3 sont des escorteurs amis.",
    "ar": "تحديث الصورة المركزية: المسارات U-4 وU-5 معادية، الإطلاق مسموح. U-2 وU-3 مرافقتان صديقتان."
   }
  },
  "falsebannerflag_2": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Two tags changed colour while I was looking at them. Overwatch — verify. I will not fire on a tag.",
    "fr": "Deux tags ont changé de couleur pendant que je les regardais. Overwatch — vérifiez. Je ne tire pas sur un tag.",
    "ar": "علامتان غيّرتا لونهما وأنا أنظر إليهما. المراقبة — تحققي. لن أطلق على علامة."
   }
  },
  "falsebannerflag_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "firm",
   "text": {
    "en": "Command insists. You are cleared on U-4 and U-5, Falcon.",
    "fr": "Le Commandement insiste. Vous êtes autorisé sur U-4 et U-5, Falcon.",
    "ar": "القيادة تصرّ. مسموح لك على U-4 وU-5 يا فالكون."
   }
  },
  "falsebannerflag_4": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Negative. Visual identification first. Closing now.",
    "fr": "Négatif. Identification visuelle d'abord. Je m'approche.",
    "ar": "سلبي. التعريف البصري أولًا. أقترب الآن."
   }
  },
  "falsebannerflag_5": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "Salim... the IFF key rotates every four hours. Nadia, apply sequence seven-one-three. I should have told you two years ago.",
    "fr": "Salim... la clé IFF tourne toutes les quatre heures. Nadia, appliquez la séquence sept-un-trois. J'aurais dû vous le dire il y a deux ans.",
    "ar": "سليم... مفتاح التعريف يتبدّل كل أربع ساعات. ناديا، طبّقي التسلسل سبعة-واحد-ثلاثة. كان عليّ إخباركم قبل سنتين."
   }
  },
  "falsebannerflag_6": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Retagging — U-4 and U-5 friendly, U-2 and U-3 HOSTILE! They are turning on the airliner!",
    "fr": "Reclassification — U-4 et U-5 amis, U-2 et U-3 HOSTILES ! Ils se tournent vers l'avion civil !",
    "ar": "إعادة التصنيف — U-4 وU-5 صديقتان، U-2 وU-3 معاديتان! تلتفتان نحو الطائرة المدنية!"
   }
  },
  "falsebannerflag_7": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Flares, Sahel! Falcon Two on the left shooter — Salim, take the right!",
    "fr": "Leurres, Sahel ! Falcon Deux sur le tireur de gauche — Salim, prends celui de droite !",
    "ar": "مشاعل يا ساحل! فالكون اثنان على مطلق اليسار — سليم، خذ اليمين!"
   }
  },
  "falsebannerflag_8": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "One shooter down. The other is still hunting the airliner!",
    "fr": "Un tireur abattu. L'autre chasse encore l'avion civil !",
    "ar": "سقط مطلق نار. الآخر ما زال يطارد الطائرة المدنية!"
   }
  },
  "falsebannerflag_9": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Sahel two-eleven is clear. The picture has been rewritten — the whole grid was lying.",
    "fr": "Sahel deux-onze est en sécurité. L'image est réécrite — toute la grille mentait.",
    "ar": "ساحل 211 بأمان. أُعيدت كتابة الصورة — الشبكة كلها كانت تكذب."
   }
  },
  "falsebannerflag_10": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "The network is called VESPER, and Shadow Line is real: the strike package launches at dawn on the coast.",
    "fr": "Le réseau s'appelle VESPER, et Shadow Line est réel : le paquet de frappe décolle à l'aube sur la côte.",
    "ar": "الشبكة اسمها فيسبر، وخط الظل حقيقي: رزمة الضربة تقلع عند الفجر على الساحل."
   }
  }
 },
