 "lines": {
  "m02_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Falcon One, Kestrel Nine is airborne — medical cargo and a technical team. Keep her alive all the way to the island.",
    "fr": "Falcon Un, Kestrel Neuf est en l'air — cargaison médicale et équipe technique. Gardez-la en vie jusqu'à l'île.",
    "ar": "فالكون واحد، كيستريل تسعة في الجو — شحنة طبية وفريق تقني. أبقها حيّة حتى الجزيرة."
   }
  },
  "m02_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Leila aboard Kestrel. I'm decoding the scout's data burst. The forged IFF has a fingerprint — I need ten minutes.",
    "fr": "Leila à bord de Kestrel. Je décode la rafale du drone. Le faux IFF a une signature — il me faut dix minutes.",
    "ar": "ليلى على متن كيستريل. أفكّ شيفرة بيانات الطائرة المسيّرة. لتزوير التعريف بصمة — أحتاج عشر دقائق."
   }
  },
  "m02_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "A contact is shadowing Kestrel and carries a friendly tag. Nothing friendly is filed in this corridor. Treat the tag as unverified.",
    "fr": "Un contact suit Kestrel avec un marquage ami. Aucun ami n'est déposé dans ce couloir. Tag non vérifié.",
    "ar": "هدف يلاحق كيستريل ويحمل علامة صديق. لا صديق مسجّل في هذا الممر. اعتبر العلامة غير موثوقة."
   }
  },
  "m02_4": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Friendly tag, hostile airframe. The tags are being written, not read.",
    "fr": "Marquage ami, cellule hostile. Les tags sont écrits, pas lus.",
    "ar": "علامة صديق وطائرة معادية. العلامات تُكتب ولا تُقرأ."
   }
  },
  "m02_5": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Two fast movers from the east, closing on Kestrel! Intercept!",
    "fr": "Deux appareils rapides à l'est, ils foncent sur Kestrel ! Interceptez !",
    "ar": "طائرتان سريعتان من الشرق تقتربان من كيستريل! اعترضاهما!"
   }
  },
  "m02_6": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "Falcon Two engaging. Last one to splash buys the coffee, Salim.",
    "fr": "Falcon Deux engage. Le dernier à abattre paie le café, Salim.",
    "ar": "فالكون اثنان يشتبك. آخر من يُسقط يدفع ثمن القهوة يا سليم."
   }
  },
  "m02_7": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "More contacts, north-west. They're hunting the transport — don't let them through.",
    "fr": "D'autres contacts au nord-ouest. Ils chassent le transport — ne les laissez pas passer.",
    "ar": "أهداف أخرى من الشمال الغربي. يطاردون الناقلة — لا تدعهم يمرّون."
   }
  },
  "m02_8": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Splash two. Kestrel's still clean.",
    "fr": "Deux de moins. Kestrel est intact.",
    "ar": "سقطت اثنتان. كيستريل سالمة."
   }
  },
  "m02_9": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Landed safe. The forgery was signed from a relay called Echo-Four, somewhere in the Atlas. That is our next stop.",
    "fr": "Posés sans encombre. Le faux a été signé depuis un relais nommé Echo-Quatre, quelque part dans l'Atlas. Prochaine étape.",
    "ar": "هبطنا بسلام. التزوير مُوقَّع من محطة تُدعى إيكو-فور في الأطلس. هذه وجهتنا القادمة."
   }
  },
  "m02_10": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "stern",
   "text": {
    "en": "Falcon flight, Command. That finding stays inside this squadron. Nothing on open channels. Understood?",
    "fr": "Escadrille Falcon, Commandement. Cette découverte reste dans cette escadrille. Rien sur les fréquences ouvertes. Compris ?",
    "ar": "سرب فالكون، هنا القيادة. هذه المعلومة تبقى داخل السرب. لا شيء على القنوات المفتوحة. مفهوم؟"
   }
  },
  "m02_11": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Understood, sir. But why would Command fear who hears the truth?",
    "fr": "Compris, mon commandant. Mais pourquoi le Commandement craindrait-il la vérité ?",
    "ar": "مفهوم يا سيدي. لكن لماذا تخشى القيادة من يسمع الحقيقة؟"
   }
  }
 },
