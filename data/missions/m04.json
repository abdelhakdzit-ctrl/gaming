 "lines": {
  "m04_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Falcon One, Echo chain, three sites down the valley. The pod images whatever you hold in your forward cone. Fly steady.",
    "fr": "Falcon Un, chaîne Echo, trois sites dans la vallée. La nacelle photographie ce qui reste dans votre cône avant. Volez stable.",
    "ar": "فالكون واحد، سلسلة إيكو، ثلاثة مواقع في الوادي. الحاضنة تصوّر ما يبقى أمامك. حلّق بثبات."
   }
  },
  "m04_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Watch the turbulence. And stay below the ridge line if the SAM wakes up. Fog hides the valley walls.",
    "fr": "Attention aux turbulences. Et restez sous la crête si le SAM se réveille. Le brouillard cache les parois.",
    "ar": "انتبه للاضطراب. وابقَ تحت خط القمة إذا استيقظ الصاروخ الأرضي. الضباب يخفي جدران الوادي."
   }
  },
  "m04_3": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Echo-One imaged. It's rewriting tags in real time. On to site two — a SAM battery covers it.",
    "fr": "Echo-Un imagé. Il réécrit les tags en temps réel. Site deux — une batterie SAM le couvre.",
    "ar": "تم تصوير إيكو-واحد. يعيد كتابة العلامات لحظيًا. الموقع الثاني — بطارية صواريخ تحميه."
   }
  },
  "m04_4": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Second site in the can. Another battery is waking up ahead — flares ready.",
    "fr": "Deuxième site dans la boîte. Une autre batterie se réveille — leurres prêts.",
    "ar": "الموقع الثاني مصوَّر. بطارية أخرى تستيقظ أمامنا — المشاعل جاهزة."
   }
  },
  "m04_5": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Bandits! They were sitting on the exit. Salim, they knew we were coming.",
    "fr": "Bandits ! Ils attendaient à la sortie. Salim, ils savaient qu'on venait.",
    "ar": "أعداء! كانوا ينتظرون عند المخرج. سليم، كانوا يعرفون أننا قادمون."
   }
  },
  "m04_6": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Package received. The relay uplink is signed with a BA-07 authorisation key — a Command-class key. Someone with real clearance built this.",
    "fr": "Paquet reçu. La liaison est signée d'une clé BA-07 — une clé de classe Commandement. Quelqu'un d'habilité l'a construit.",
    "ar": "وصلت الحزمة. وصلة المحطة موقَّعة بمفتاح BA-07 — مفتاح من فئة القيادة. صاحب صلاحية حقيقية بناها."
   }
  },
  "m04_7": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "stern",
   "text": {
    "en": "Falcon flight, Command. Bring that package to me personally. No copies, no uploads.",
    "fr": "Escadrille Falcon, Commandement. Apportez-moi ce paquet en personne. Aucune copie, aucun envoi.",
    "ar": "سرب فالكون، هنا القيادة. أحضروا الحزمة إليّ شخصيًا. لا نسخ ولا إرسال."
   }
  }
 },
