 "lines": {
  "stormlinesky_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "VESPER strike package heading for the Ouled Taher dam through the storm front. Weather is brutal. Get there before they do.",
    "fr": "Paquet de frappe VESPER vers le barrage d'Ouled Taher à travers le front orageux. Météo brutale. Arrivez avant eux.",
    "ar": "رزمة ضربة فيسبر تتجه إلى سد أولاد طاهر عبر جبهة العاصفة. الطقس قاسٍ. ابلغوه قبلهم."
   }
  },
  "stormlinesky_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Radar returns are noisy in the storm. Trust your eyes and the callouts.",
    "fr": "Les échos radar sont bruités dans l'orage. Fiez-vous à vos yeux et aux annonces.",
    "ar": "أصداء الرادار مضطربة في العاصفة. ثق بعينيك وبالنداءات."
   }
  },
  "stormlinesky_3": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Turbulence is throwing me around! Stay loose on the stick, Salim.",
    "fr": "Les turbulences me secouent ! Souple sur le manche, Salim.",
    "ar": "الاضطراب يقذف بي! كن مرنًا على العصا يا سليم."
   }
  },
  "stormlinesky_4": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Dam under fire! They are over the spillway — Falcon, cover it!",
    "fr": "Le barrage est attaqué ! Ils sont au-dessus de la crête — Falcon, couvrez-le !",
    "ar": "السد تحت النار! هم فوق المفيض — فالكون، غطّوه!"
   }
  },
  "stormlinesky_5": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Last one down. The sky is clear of them.",
    "fr": "Le dernier est tombé. Le ciel est dégagé.",
    "ar": "سقط الأخير. السماء خالية منهم."
   }
  },
  "stormlinesky_6": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "The dam is intact. Good flying in that weather, Falcon.",
    "fr": "Le barrage est intact. Beau pilotage dans cette météo, Falcon.",
    "ar": "السد سليم. طيران ممتاز في هذا الطقس يا فالكون."
   }
  },
  "stormlinesky_7": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "Falcon One, report to me when you land. We need to speak.",
    "fr": "Falcon Un, présentez-vous à moi à l'atterrissage. Nous devons parler.",
    "ar": "فالكون واحد، قابلني عند الهبوط. علينا أن نتحدث."
   }
  }
 },
