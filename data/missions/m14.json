 "lines": {
  "greyduelsky_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Falcon One, unknown fighter on a direct vector. Signature matches Grey. Riad is grounded — you are alone up there.",
    "fr": "Falcon Un, chasseur inconnu en route directe. Signature : Grey. Riad est cloué au sol — vous êtes seul.",
    "ar": "فالكون واحد، مقاتلة مجهولة على مسار مباشر. البصمة تطابق غراي. رياض على الأرض — أنت وحدك."
   }
  },
  "greyduelsky_2": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "Salim Ben Younes. Your file says calm. Show me.",
    "fr": "Salim Ben Younes. Ton dossier dit calme. Montre-moi.",
    "ar": "سليم بن يونس. ملفك يقول هادئ. أرني."
   }
  },
  "greyduelsky_3": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Grey. Let's finish what you started.",
    "fr": "Grey. Finissons ce que tu a commencé.",
    "ar": "غراي. لننهِ ما بدأته."
   }
  },
  "greyduelsky_4": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "Follow me. The coast is too open.",
    "fr": "Suis-moi. La côte est trop dégagée.",
    "ar": "اتبعني. الساحل مفتوح أكثر من اللازم."
   }
  },
  "greyduelsky_5": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "He is dragging me into the mountains. Fine — I know ridgelines too.",
    "fr": "Il m'entraîne dans les montagnes. Soit — je connais les crêtes aussi.",
    "ar": "يجرّني إلى الجبال. حسنًا — أعرف الحافات أيضًا."
   }
  },
  "greyduelsky_6": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "Better. Now the rocks.",
    "fr": "Mieux. Maintenant, les rochers.",
    "ar": "أفضل. الآن الصخور."
   }
  },
  "greyduelsky_7": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Salim, his transponder is Command-issue. Every tag in this war came from our own side.",
    "fr": "Salim, son transpondeur est du Commandement. Tous les tags de cette guerre venaient de chez nous.",
    "ar": "سليم، جهاز تعريفه من القيادة. كل علامة في هذه الحرب جاءت من جانبنا."
   }
  },
  "greyduelsky_8": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "He is above you, high sun side. Break when he commits!",
    "fr": "Il est au-dessus de vous, côté soleil. Cassez quand il engage !",
    "ar": "هو فوقك من جهة الشمس. اكسر عندما يلتزم!"
   }
  },
  "greyduelsky_9": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "...Good.",
    "fr": "...Bien.",
    "ar": "...جيد."
   }
  },
  "greyduelsky_10": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "Tell Ben Aissa the line was never mine to cut.",
    "fr": "Dis à Ben Aissa que la ligne n'était pas à moi de couper.",
    "ar": "قل لبن عيسى إن الخط لم يكن لي لأقطعه."
   }
  },
  "greyduelsky_11": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "What line, Grey?",
    "fr": "Quelle ligne, Grey ?",
    "ar": "أي خط يا غراي؟"
   }
  },
  "greyduelsky_12": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "Parachute — he is alive. Falcon One, come home. The last pieces are in the final operation.",
    "fr": "Parachute — il est vivant. Falcon Un, rentrez. Les dernières pièces sont dans l'opération finale.",
    "ar": "مظلة — إنه حيّ. فالكون واحد، عد إلى القاعدة. القطع الأخيرة في العملية النهائية."
   }
  }
 },
