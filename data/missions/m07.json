 "lines": {
  "shopsoakmind_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "All radar is down across the sector — hard jamming. I will give you gates by heading. Gate one: zero-one-five, twelve kilometres.",
    "fr": "Tous les radars sont HS sur le secteur — brouillage dur. Je vous donne les points par cap. Point un : zéro-un-cinq, douze kilomètres.",
    "ar": "كل الرادارات معطّلة في القطاع — تشويش شديد. سأعطيك البوابات بالاتجاه. البوابة الأولى: صفر-واحد-خمسة، اثنا عشر كيلومترًا."
   }
  },
  "shopsoakmind_2": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Gate passed. Next gate: three-one-five, thirteen kilometres. Stay low over the dunes.",
    "fr": "Point franchi. Prochain point : trois-un-cinq, treize kilomètres. Restez bas sur les dunes.",
    "ar": "عبرت البوابة. التالية: ثلاثة-واحد-خمسة، ثلاثة عشر كيلومترًا. ابقَ منخفضًا فوق الكثبان."
   }
  },
  "shopsoakmind_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "I cannot paint them — calling by eye. Bandits behind you!",
    "fr": "Je ne les vois pas au radar — annonce à vue. Bandits derrière vous !",
    "ar": "لا أراهم على الرادار — أنادي بالعين. أعداء خلفك!"
   }
  },
  "shopsoakmind_4": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Gate three passed. Last gate: three-five-five, eleven kilometres.",
    "fr": "Point trois franchi. Dernier point : trois-cinq-cinq, onze kilomètres.",
    "ar": "عبرت البوابة الثالثة. الأخيرة: ثلاثة-خمسة-خمسة، أحد عشر كيلومترًا."
   }
  },
  "shopsoakmind_5": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "The jamming is airborne — a cargo hull tagged friendly, orbiting near gate four. Do not trust the tag.",
    "fr": "Le brouillage est aéroporté — une cellule cargo marquée amie, en orbite près du point quatre. Ne faites pas confiance au tag.",
    "ar": "التشويش محمول جوًا — بدن شحن بعلامة صديق يدور قرب البوابة الرابعة. لا تثق بالعلامة."
   }
  },
  "shopsoakmind_6": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Visual. Cargo hull, no markings, antennas all along the belly. Hostile.",
    "fr": "Visuel. Cellule cargo sans marquage, antennes sous le ventre. Hostile.",
    "ar": "رؤية مباشرة. بدن شحن بلا علامات وهوائيات تحت البطن. معادٍ."
   }
  },
  "shopsoakmind_7": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Picture's back — all of it. Salim, your eyes were right and the tags were wrong.",
    "fr": "L'image est revenue — toute. Salim, tes yeux avaient raison, les tags avaient tort.",
    "ar": "عادت الصورة كاملة. سليم، عيناك كانتا على حق والعلامات على خطأ."
   }
  },
  "shopsoakmind_8": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Whoever built that jammer built it to look like one of ours.",
    "fr": "Celui qui a construit ce brouilleur l'a fait pour ressembler à l'un des nôtres.",
    "ar": "من بنى هذا المشوّش صنعه ليبدو واحدًا منا."
   }
  }
 },
