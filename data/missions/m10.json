 "lines": {
  "nightsandwatch_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Falcon flight, scramble, scramble! Hassi Khalil is under attack — six bandits, no lights.",
    "fr": "Escadrille Falcon, décollage immédiat ! Hassi Khalil est attaquée — six bandits, sans feux.",
    "ar": "سرب فالكون، إقلاع فوري! حاسي خليل تحت الهجوم — ستة أعداء بلا أضواء."
   }
  },
  "nightsandwatch_2": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "stern",
   "text": {
    "en": "Defend the radar and the fuel, in that order. Weapons free.",
    "fr": "Défendez le radar et le carburant, dans cet ordre. Armes libres.",
    "ar": "احموا الرادار والوقود بهذا الترتيب. الإطلاق مسموح."
   }
  },
  "nightsandwatch_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "First pair from the east, low and dark. They are going for the radar!",
    "fr": "Première paire par l'est, basse et sombre. Ils visent le radar !",
    "ar": "الزوج الأول من الشرق، منخفض ومظلم. يستهدفون الرادار!"
   }
  },
  "nightsandwatch_4": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Second pair from the west. Flares light them up — use them.",
    "fr": "Deuxième paire par l'ouest. Les leurres les éclairent — utilisez-les.",
    "ar": "الزوج الثاني من الغرب. المشاعل تكشفهم — استخدمها."
   }
  },
  "nightsandwatch_5": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Last wave. One of them flies like a real pilot, Salim — careful.",
    "fr": "Dernière vague. L'un d'eux vole comme un vrai pilote, Salim — prudence.",
    "ar": "الموجة الأخيرة. أحدهم يطير كطيار حقيقي يا سليم — احذر."
   }
  },
  "nightsandwatch_6": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Sir. The Black Sand logs carry your signature. BA-07, M.B.A.",
    "fr": "Mon commandant. Les journaux de Sable Noir portent votre signature. BA-07, M.B.A.",
    "ar": "سيدي. سجلات الرمال السوداء تحمل توقيعك. بي أيه-07، إم بي إيه."
   }
  },
  "nightsandwatch_7": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "Land, Falcon One. We will talk on the ground. Not on this channel.",
    "fr": "Posez-vous, Falcon Un. On parlera au sol. Pas sur ce canal.",
    "ar": "اهبط يا فالكون واحد. سنتحدث على الأرض. ليس على هذه القناة."
   }
  },
  "nightsandwatch_8": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Salim... what did you just say to the Major?",
    "fr": "Salim... qu'est-ce que tu viens de dire au commandant ?",
    "ar": "سليم... ماذا قلت للرائد للتو؟"
   }
  }
 },
