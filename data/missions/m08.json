 "lines": {
  "blackbasketsand_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Black Sand relay: the master node behind the forged tags. Three SAM batteries, one radar, one fuel depot. Kill the mast and the depot.",
    "fr": "Relais Sable Noir : le noeud maître des faux tags. Trois SAM, un radar, un dépôt de carburant. Détruisez le mât et le dépôt.",
    "ar": "محطة الرمال السوداء: العقدة الرئيسية خلف العلامات المزوّرة. ثلاث بطاريات صواريخ ورادار ومستودع وقود. دمّروا الصاري والمستودع."
   }
  },
  "blackbasketsand_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "The depot feeds the backup generators. Burn it and the mast goes dark in minutes.",
    "fr": "Le dépôt alimente les groupes de secours. Brûlez-le et le mât s'éteint en quelques minutes.",
    "ar": "المستودع يغذي المولدات الاحتياطية. أحرقه فيظلم الصاري خلال دقائق."
   }
  },
  "blackbasketsand_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "SAM radars are lit. Flares, terrain, and keep your speed up.",
    "fr": "Radars SAM allumés. Leurres, relief, et gardez votre vitesse.",
    "ar": "رادارات الصواريخ تعمل. مشاعل وتضاريس وحافظ على سرعتك."
   }
  },
  "blackbasketsand_4": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Raiders off the east — they were sleeping under camo nets.",
    "fr": "Raiders par l'est — ils dormaient sous des filets de camouflage.",
    "ar": "مغيرون من الشرق — كانوا نائمين تحت شباك التمويه."
   }
  },
  "blackbasketsand_5": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "Mast is down! That is a lot of copper on fire.",
    "fr": "Le mât est tombé ! Beaucoup de cuivre en feu.",
    "ar": "سقط الصاري! الكثير من النحاس يحترق."
   }
  },
  "blackbasketsand_6": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Depot burning. Black Sand is dark.",
    "fr": "Dépôt en feu. Sable Noir est éteint.",
    "ar": "المستودع يحترق. الرمال السوداء مظلمة."
   }
  },
  "blackbasketsand_7": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "We caught the relay's last burst. It was addressed to a Command net — BA-07.",
    "fr": "Nous avons capté la dernière émission du relais. Elle était adressée à un réseau du Commandement — BA-07.",
    "ar": "التقطنا آخر بث للمحطة. كان موجّهًا إلى شبكة قيادة — بي أيه-07."
   }
  },
  "blackbasketsand_8": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Command? Which Command, exactly?",
    "fr": "Le Commandement ? Lequel, exactement ?",
    "ar": "القيادة؟ أي قيادة بالضبط؟"
   }
  },
  "blackbasketsand_9": {
   "speaker": "MOURAD",
   "voice": null,
   "emotion": "stern",
   "text": {
    "en": "Return to base, Falcon One. Debrief — immediately.",
    "fr": "Retour à la base, Falcon Un. Compte rendu — immédiatement.",
    "ar": "عد إلى القاعدة يا فالكون واحد. جلسة تقرير — فورًا."
   }
  }
 },
