 "lines": {
  "masterlistmile_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Courier jet Mirage lifted off from a strip near the border. VESPER's key material is aboard. Do not let it cross the Tassili line.",
    "fr": "Le jet courrier Mirage a décollé près de la frontière. Le matériel clé de VESPER est à bord. Ne le laissez pas franchir la ligne du Tassili.",
    "ar": "الطائرة الناقلة ميراج أقلعت من مدرج قرب الحدود. على متنها مواد مفاتيح فيسبر. لا تدعها تعبر خط الطاسيلي."
   }
  },
  "masterlistmile_2": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "He's fast, Salim. We will be faster.",
    "fr": "Il est rapide, Salim. On sera plus rapides.",
    "ar": "إنها سريعة يا سليم. سنكون أسرع."
   }
  },
  "masterlistmile_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Two raiders covering him. The courier is the target — ignore the rest if you can.",
    "fr": "Deux raiders le couvrent. Le courrier est la cible — ignorez le reste si possible.",
    "ar": "مغيران يغطيانها. الناقلة هي الهدف — تجاهل الباقي إن استطعت."
   }
  },
  "masterlistmile_4": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "Turn around, Falcon.",
    "fr": "Fais demi-tour, Falcon.",
    "ar": "عد أدراجك يا فالكون."
   }
  },
  "masterlistmile_5": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Grey. Of course.",
    "fr": "Grey. Évidemment.",
    "ar": "غراي. بالطبع."
   }
  },
  "masterlistmile_6": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Flight recorder is intact in the wreck. Strike plan: SHADOW LINE — a false attack on the coast at dawn, during the joint exercise.",
    "fr": "Le enregistreur de vol est intact dans l'épave. Plan : SHADOW LINE — une fausse attaque sur la côte à l'aube, pendant l'exercice conjoint.",
    "ar": "مسجّل الرحلة سليم في الحطام. خطة الضربة: خط الظل — هجوم كاذب على الساحل عند الفجر أثناء التمرين المشترك."
   }
  }
 },
