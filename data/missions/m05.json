 "lines": {
  "m05_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Convoy Dust is moving Echo-Four's transponder core, salvaged by Leila's team. VESPER wants it back. Keep the trucks rolling.",
    "fr": "Le convoi Dust transporte le noyau transpondeur d'Echo-Quatre récupéré par l'équipe de Leila. VESPER le veut. Gardez les camions en route.",
    "ar": "قافلة داست تنقل نواة جهاز الإرسال من إيكو-فور التي استعادها فريق ليلى. فيسبر تريدها. أبقِ الشاحنات تتحرك."
   }
  },
  "m05_2": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "If they get that core, the evidence is gone. It's the only proof the forged tags came from a real network.",
    "fr": "S'ils prennent ce noyau, la preuve disparaît. C'est la seule preuve que les faux tags viennent d'un vrai réseau.",
    "ar": "إن أخذوا النواة تضيع الأدلة. إنها الدليل الوحيد على أن العلامات المزوّرة من شبكة حقيقية."
   }
  },
  "m05_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Raiders from the east, strafing the trucks! Pull them off the convoy!",
    "fr": "Raiders à l'est, ils mitraillent les camions ! Éloignez-les du convoi !",
    "ar": "مغيرون من الشرق يقصفون الشاحنات! اسحبوهم بعيدًا عن القافلة!"
   }
  },
  "m05_4": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Second pair from the west, low in the dust.",
    "fr": "Deuxième paire par l'ouest, bas dans la poussière.",
    "ar": "زوج ثانٍ من الغرب، منخفض داخل الغبار."
   }
  },
  "m05_5": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "tense",
   "text": {
    "en": "Last wave — and one of them isn't a raider. He's a fighter. He's hunting us, Salim.",
    "fr": "Dernière vague — et l'un d'eux n'est pas un raider. C'est un chasseur. Il nous chasse, Salim.",
    "ar": "الموجة الأخيرة — وأحدهم ليس مغيرًا. إنه مقاتلة. يطاردنا يا سليم."
   }
  },
  "m05_6": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "Two raiders down. Trucks still moving — the dust is thick but they're moving.",
    "fr": "Deux raiders abattus. Les camions avancent — la poussière est épaisse mais ils avancent.",
    "ar": "سقط مغيران. الشاحنات ما زالت تتحرك — الغبار كثيف لكنها تتحرك."
   }
  },
  "m05_7": {
   "speaker": "LEILA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Convoy at the depot. The core is secure. Thank you, Falcon.",
    "fr": "Convoi au dépôt. Le noyau est en sécurité. Merci, Falcon.",
    "ar": "القافلة وصلت المستودع. النواة بأمان. شكرًا فالكون."
   }
  },
  "m05_8": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "One more thing — a helicopter went down west of the ridge, Mule Two. Beacon active. That is tomorrow's problem.",
    "fr": "Une dernière chose — un hélicoptère est tombé à l'ouest de la crête, Mule Deux. Balise active. C'est pour demain.",
    "ar": "أمر أخير — مروحية سقطت غرب القمة، ميول اثنان. المنارة تعمل. هذه مشكلة الغد."
   }
  }
 },
