 "lines": {
  "m03_1": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "calm",
   "text": {
    "en": "Four bandits inbound, red tail markings. They sank a patrol boat ten minutes ago. Weapons free, Falcon.",
    "fr": "Quatre bandits en approche, empennages rouges. Ils ont coulé une vedette il y a dix minutes. Armes libres, Falcon.",
    "ar": "أربع طائرات معادية بعلامات حمراء. أغرقت زورق دورية قبل عشر دقائق. الإطلاق مسموح يا فالكون."
   }
  },
  "m03_2": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "Bandits at twelve. Let's dance, Salim.",
    "fr": "Bandits à midi. On danse, Salim.",
    "ar": "أعداء أمامنا. لنرقص يا سليم."
   }
  },
  "m03_3": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "urgent",
   "text": {
    "en": "Two more, six o'clock — they came in low behind you!",
    "fr": "Deux autres, à six heures — ils sont arrivés bas derrière vous !",
    "ar": "اثنان آخران خلفك — جاءا على ارتفاع منخفض!"
   }
  },
  "m03_4": {
   "speaker": "GREY",
   "voice": null,
   "emotion": "cold",
   "text": {
    "en": "You fly like him.",
    "fr": "Tu voles comme lui.",
    "ar": "تطير مثله."
   }
  },
  "m03_5": {
   "speaker": "SALIM",
   "voice": null,
   "emotion": "analytical",
   "text": {
    "en": "Like who? Say again, unknown caller.",
    "fr": "Comme qui ? Répétez, appelant inconnu.",
    "ar": "مثل من؟ أعد يا متصل مجهول."
   }
  },
  "m03_6": {
   "speaker": "NADIA",
   "voice": null,
   "emotion": "shaken",
   "text": {
    "en": "Contact is leaving at speed. He never fired. Falcon One, he was only watching.",
    "fr": "Le contact s'éloigne vite. Il n'a pas tiré. Falcon Un, il observait seulement.",
    "ar": "الهدف يبتعد بسرعة. لم يطلق النار. فالكون واحد، كان يراقب فقط."
   }
  },
  "m03_7": {
   "speaker": "RIAD",
   "voice": null,
   "emotion": "playful",
   "text": {
    "en": "Red One's down! These guys fly like they're reading a manual.",
    "fr": "Rouge Un est tombé ! Ils volent comme s'ils lisaient un manuel.",
    "ar": "سقط الأحمر واحد! يطيرون كأنهم يقرؤون من كتيّب."
   }
  }
 },
